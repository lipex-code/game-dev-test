{
  "expo": {
    "name": "Last Light Way",
    "slug": "meuJogo",
    "version": "1.0.0",
    "orientation": "portrait",

    "icon": "./assets/icon.png",

    "scheme": "meujogo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.fernanda.lastlightway"
    },

    "androidStatusBar": {
      "hidden": true,
      "translucent": true,
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content"
    },

    "androidNavigationBar": {
      "visible": "immersive",
      "backgroundColor": "#000000",
      "barStyle": "light-content"
    },

    "web": {
      "output": "static",
      "favicon": "./assets/icon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      "@react-native-community/datetimepicker"
    ],

    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },

    "extra": {
      "router": {},
      "eas": {
        "projectId": "3cf475fb-70ab-4d91-8eb6-482d0bc6159e"
      }
    }
  }
}